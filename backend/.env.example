# HackNU25 Backend Configuration
# Copy this to .env and add your actual values

# OpenAI API (Required for PDF analysis)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (if using main app features)
DATABASE_URL=postgresql://user:password@localhost/hacknu25

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8001

# Security
JWT_SECRET_KEY=your-secret-key-here

# Redis (if using caching/background jobs)
REDIS_URL=redis://localhost:6379

# PDF Processing Limits
MAX_PDF_SIZE_MB=10
MAX_PAGES=50